{
	"buildCommand": "npm run build",
	"outputDirectory": "build",
	"redirects": [
		{
			"source": "/",
			"has": [{ "type": "host", "value": "mixes.doxxus.ca" }],
			"destination": "https://doxxus.ca/mixes",
			"permanent": false
		},
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "mixes.doxxus.ca" }],
			"destination": "https://doxxus.ca/mixes/:path*",
			"permanent": false
		}
	],
	"rewrites": [{ "source": "/((?!_app/|assets/|Covers/).*)", "destination": "/index.html" }]
}
